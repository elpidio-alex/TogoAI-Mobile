# But : Gabarit des variables d'environnement pour configurer l'application Flutter TogoAI Mobile (Supabase, Backend FastAPI, OAuth et drapeaux de sécurité).

# ==============================================================================
# INSTRUCTIONS D'UTILISATION :
# 1. Copiez ce fichier sous le nom '.env' à la racine du projet :
#      cp .env.example .env (ou Copy-Item .env.example .env sous PowerShell)
# 2. Renseignez vos clés et paramètres réels dans le fichier '.env'.
# 3. Ce fichier '.env' est strictement ignoré par Git (sécurité des secrets).
# 4. Lors du lancement, utilisez le script d'automatisation :
#      .\scripts\run.ps1 -device chrome (ou android / windows)
#    ou ajoutez l'argument Flutter :
#      --dart-define-from-file=.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONFIGURATION SUPABASE (Base de données, Auth & RLS)
# ------------------------------------------------------------------------------
# URL de votre projet Supabase (Dashboard -> Settings -> API)
SUPABASE_URL=https://rmrskgankgezjttoiwud.supabase.co

# Clé publique anonyme (anon / public key) pour les requêtes client sécurisées par RLS
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJtcnNrZ2Fua2dlemp0dG9pd3VkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYzNTYwODEsImV4cCI6MjEwMTkzMjA4MX0.XglWmCrrM1FyHx9dXvUDBQ7gYMq7z2ROlgEFY7W055k

# Alias compatibles avec le frontend Web Next.js (automatiquement mappés par run.ps1)
# NEXT_PUBLIC_SUPABASE_URL=https://rmrskgankgezjttoiwud.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. BACKEND TOGOAI FASTAPI (Moteur IA, RAG documentaire & Inférence temps réel)
# ------------------------------------------------------------------------------
# En développement local (Web ou Desktop) :
BACKEND_URL=http://localhost:8000

# Pour l'émulateur Android standard :
# L'application réécrit automatiquement 'localhost' ou '127.0.0.1' en '10.0.2.2'.
# Vous pouvez aussi le définir explicitement :
# BACKEND_URL=http://10.0.2.2:8000

# Pour un smartphone physique en Wi-Fi :
# Remplacez par l'adresse IP locale de votre machine de développement :
# BACKEND_URL=http://192.168.1.50:8000

# En environnement de production (cluster cloud Render) :
# BACKEND_URL=https://togoai.onrender.com

# ------------------------------------------------------------------------------
# 3. REDIRECTIONS OAUTH (Google Sign-In & Authentification externe)
# ------------------------------------------------------------------------------
# Schéma Deep Link personnalisé pour applications mobiles natives (Android / iOS)
# Doit être impérativement ajouté dans Supabase -> Authentication -> URL Configuration -> Redirect URLs
OAUTH_REDIRECT_URL=io.togoai.app://login-callback/

# URL de redirection pour l'environnement Web de développement :
# OAUTH_REDIRECT_URL=http://localhost:5555/auth/callback

# ------------------------------------------------------------------------------
# 4. SÉCURITÉ & DRAPEAUX D'EXÉCUTION
# ------------------------------------------------------------------------------
# Détermine si le JWT de session Supabase doit être transmis au backend FastAPI
# (Authorization: Bearer <token>) lors des requêtes de streaming SSE :
SEND_JWT_TO_BACKEND=false

# Clé secrète interne pour les environnements de test / CI sécurisés
# ATTENTION : Ne JAMAIS inclure de clé secrète de production dans un binaire public (APK / AAB / IPA).
INTERNAL_API_KEY=
