# Copier vers .env (non commité)

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Backend FastAPI local ou prod
BACKEND_URL=http://localhost:8000
# BACKEND_URL=https://togoai.onrender.com

# Deep link mobile
OAUTH_REDIRECT_URL=io.togoai.app://login-callback/

# Web/Chrome (dev) — ajouter aussi cette URL dans Supabase Redirect URLs
# OAUTH_REDIRECT_URL=http://localhost:*/auth/callback

# NE JAMAIS mettre INTERNAL_API_KEY ici pour une build store
# INTERNAL_API_KEY=
